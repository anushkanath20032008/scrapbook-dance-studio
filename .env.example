# Copy to .env.local for local development (untracked via *.local).
# Never put secrets in the tracked .env, which Lovable manages.

# Supabase (publishable values; also injected by Lovable Cloud)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dodo Payments: server-only, for Choreo Studio's own studio subscriptions
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_STARTER_PRODUCT_ID=
DODO_PAYMENTS_GROWTH_PRODUCT_ID=
DODO_PAYMENTS_STUDIO_PRODUCT_ID=
# Optional dollar products for other countries, bands A (lowest price) to D (highest); unset bands use the main product.
DODO_PAYMENTS_STARTER_PRODUCT_ID_A=
DODO_PAYMENTS_STARTER_PRODUCT_ID_B=
DODO_PAYMENTS_STARTER_PRODUCT_ID_C=
DODO_PAYMENTS_STARTER_PRODUCT_ID_D=
DODO_PAYMENTS_STUDIO_PRODUCT_ID_A=
DODO_PAYMENTS_STUDIO_PRODUCT_ID_B=
DODO_PAYMENTS_STUDIO_PRODUCT_ID_C=
DODO_PAYMENTS_STUDIO_PRODUCT_ID_D=

# Public base URL for checkout return links, e.g. https://www.choreostudio.live
# (falls back to the request's own origin when unset)
PUBLIC_APP_URL=

# Supabase service role: server-only. Used by the Dodo webhook, the reminder job and the public family view.
# Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Reminder job: the scheduler (for example a Render cron job) calls POST /api/jobs/send-reminders with
# "Authorization: Bearer <RENDER_JOB_SECRET>". Use a long random value.
RENDER_JOB_SECRET=

# WhatsApp provider (any HTTPS service that accepts the JSON the job sends). Leave unset to keep reminders queued.
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=

# Telegram reminder bot (free): server-only. Create the bot in @BotFather, then set all three.
# TELEGRAM_WEBHOOK_SECRET is any random string of A-Z a-z 0-9 _ - (up to 256 characters); pass the same value as
# secret_token when you call setWebhook. Leave unset to hide the Telegram options.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
