# Copy to .env.local for local development (untracked via *.local).
# Never put secrets in the tracked .env, which Lovable manages.

# Supabase (publishable values; also injected by Lovable Cloud)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dodo Payments: server-only, for Choreo Studio's own studio subscriptions
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_STARTER_PRODUCT_ID=
DODO_PAYMENTS_GROWTH_PRODUCT_ID=
DODO_PAYMENTS_STUDIO_PRODUCT_ID=

# Public base URL for checkout return links, e.g. https://www.choreostudio.live
# (falls back to the request's own origin when unset)
PUBLIC_APP_URL=

# Supabase service role: server-only. Used by the Dodo webhook, the reminder job and the public family view.
# Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Reminder job: the scheduler (for example a Render cron job) calls POST /api/jobs/send-reminders with
# "Authorization: Bearer <RENDER_JOB_SECRET>". Use a long random value.
RENDER_JOB_SECRET=

# WhatsApp provider (any HTTPS service that accepts the JSON the job sends). Leave unset to keep reminders queued.
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
