# Copy to .env for local development. Never commit real secrets.

# Supabase (publishable values; also injected by Lovable Cloud)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dodo Payments: server-only, for Choreo Studio's own studio subscriptions
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_STARTER_PRODUCT_ID=
DODO_PAYMENTS_GROWTH_PRODUCT_ID=
DODO_PAYMENTS_STUDIO_PRODUCT_ID=

# Public base URL used for checkout return links, e.g. https://www.choreostudio.live
PUBLIC_APP_URL=
